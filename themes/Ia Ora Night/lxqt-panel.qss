/*
	"Ia Ora Night" - LXQt port of Mandrake/Mandriva's default KDE style.
	For LXQt 2.4.x and above.

	by Azuma Hazuki (wandering hazuki at gee mail dot calm)
*/

/* Panel */
LXQtPanel, LXQtPanel #BackgroundWidget {
	color: #000000;
	background: #eff3f7;
}

/* Panel borders */
LXQtPanel[position="Top"] #BackgroundWidget { border-bottom: 1px solid #96aabe; }
LXQtPanel[position="Bottom"] #BackgroundWidget { border-top: 1px solid #96aabe; }
LXQtPanel[position="Left"] #BackgroundWidget { border-left: 1px solid #96aabe; }
LXQtPanel[position="Right"] #BackgroundWidget { border-right: 1px solid #96aabe; }

/* Catch-all settings for panel plugins and their subwidgets
    not otherwise styled in this theme:
    #ColorPicker
    #Custom and #CustomButton
    #DirectoryMenu
    #Dom
    #LXQtMount
    #NetworkMonitor
    #Sensors
*/
Plugin, Plugin > QToolButton, Plugin > QWidget > QToolButton,
Plugin > QWidget > QToolButton > QWidget > QToolButton {
    color: #000000;
    background: transparent;
    margin: 0px;
    padding: 0px;
    /* prevents unexpected borders/boxes on hover */
    border: 0px solid transparent;
}

/* Tooltips */
QToolTip {
	color: #000000;
	background: #ffff94;
	border: none;
	padding: 1px;
}

/* Start buttons */
#MainMenu,
#FancyMenu {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: none;
	qproperty-icon: url(assets/menus/mainmenu.svg);
	padding: 4px 0px;
}

#MainMenu:hover,
#FancyMenu:hover {
	border-image: url(assets/buttons/button-hover.svg);
}

#MainMenu:pressed,
#FancyMenu:pressed {
	border-image: url(assets/buttons/button-pressed.svg);
}

/* Taskbar and Desktop Switcher */
#TaskBar QToolButton,
#DesktopSwitch QToolButton {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/buttons/button.svg);
	margin: 0px;
	padding: 2px;
}

#TaskBar QToolButton:hover,
#DesktopSwitch QToolButton:hover {
	border-image: url(assets/buttons/button-hover.svg);
}

#TaskBar QToolButton:on:hover,
#DesktopSwitch QToolButton:on:hover {
	border-image: url(assets/buttons/button-on-hover.svg);
}

#TaskBar QToolButton:on,
#TaskBar QToolButton:pressed,
#DesktopSwitch QToolButton:on,
#DesktopSwitch QToolButton:pressed {
	border-image: url(assets/buttons/button-pressed.svg);
}

#TaskBar QToolButton[urgent="true"],
#DesktopSwitch QToolButton[urgent="true"] {
	color: #000000;
	border-image: url(assets/buttons/button-urgent.svg);
}

/* Launchers */
#QuickLaunchPlaceHolder {
	color: #000000;
	background: transparent;
	padding: 2px;
}

#ShowDesktop,
#QuickLaunch QToolButton {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: none;
	margin: 1px 0px;
	padding: 2px 0px;
}

#ShowDesktop:hover,
#QuickLaunch QToolButton:hover {
	border-image: url(assets/buttons/button-hover.svg);
}

#ShowDesktop:pressed,
#QuickLaunch QToolButton:pressed {
	border-image: url(assets/buttons/button-pressed.svg);
}

/* Menus */
QMenu {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/menus/frame.svg);
	min-width: 120px;
}

QMenu::item {
	color: #000000;
	background: transparent;
	border: 0px solid transparent;
	min-width: 120px;
	min-height: 21px;
	padding: 0px 5px 0px 7px;
}

QMenu::item:hover,
QMenu::item:selected {
	color: #ffffff;
	border-image: url(assets/menus/menuitem.svg);
}

QMenu::item:disabled {
	color: #b6c3cf;
}

QMenu::icon {
	margin-left: 7px;
}

QMenu::indicator {
	margin-left: 6px;
}

QMenu::indicator::non-exclusive:checked { image: url(assets/boxes/checked.svg); }
QMenu::indicator::non-exclusive:unchecked { image: url(assets/boxes/unchecked.svg); }

QMenu::separator {
	color: #ccd6d8;
	background: #ccd6d8;
	margin: 0px 5px;
}

QMenu QLineEdit {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/boxes/entry.svg);
	selection-color: #ffffff;
	selection-background-color: #5d658e;
	margin: 0px;
	padding: 2px 1px;
}


QMenu QAbstractButton {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/buttons/button.svg);
}

QMenu::left-arrow {
	image: url(assets/arrows/arrow-left.svg);
	padding-left: 5px;
}

QMenu::right-arrow {
	image: url(assets/arrows/arrow-right.svg);
	padding-right: 5px;
}

QMenu::left-arrow:selected {
	image: url(assets/arrows/arrow-left-selected.svg);
	padding-left: 5px;
}

QMenu::right-arrow:selected {
	image: url(assets/arrows/arrow-right-selected.svg);
	padding-right: 5px;
}

/* Filter mode ("ActionView") of main menu */
#MainMenu ActionView {
	color: #000000;
	background: #ffffff;
	border: 1px solid #a0b2c0;
	border-radius: 1px;
	margin: 2px;
}

#MainMenu ActionView::item {
	color: #000000;
	background: transparent;
	border: 0px solid transparent;
	min-height: 21px;
}

#MainMenu ActionView::item:hover,
#MainMenu ActionView::item:selected {
	color: #ffffff;
	border-image: url(assets/menus/menuglow.svg);
}

/* New (LXQt 2.x and up "Fancy Menu" applications menu */
LXQtFancyMenuWindow {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/menus/frame.svg);	
}

#FancyMenu #AppView {
	color: #000000;
	background: #ffffff;
	border: 1px solid #a0b2c0;
	border-radius: 1px;
	icon-size: 16px;
}

#FancyMenu #AppView::item {
	color: #000000;
	background: transparent;
	border: 0px solid transparent;
}

#FancyMenu #AppView::item:hover,
#FancyMenu #AppView::item:selected {
	color: #ffffff;
	border-image: url(assets/menus/menuglow.svg);
}

#FancyMenu #CategoryView {
	color: #000000;
	background: transparent;
	icon-size: 24px;
}

#FancyMenu #CategoryView::item {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: none;
}

#FancyMenu #CategoryView::item:hover,
#FancyMenu #CategoryView::item:selected {
	border-image: url(assets/buttons/button-hover.svg);
}

#FancyMenu QLineEdit {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/boxes/entry.svg);
	selection-color: #ffffff;
	selection-background-color: #5d658e;
	padding: 2px 1px;
}

#FancyMenu QToolButton {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/buttons/button.svg);
	qproperty-iconSize: 24px;
}

#FancyMenu QToolButton:hover {
	border-image: url(assets/buttons/button-hover.svg);
}

#FancyMenu QToolButton:pressed {
	border-image: url(assets/buttons/button-pressed.svg);
}

#FancyMenu QListView::focus {
    outline: transparent;
}

#FancyMenu QAbstractScrollArea::corner {
    color: transparent;
    background: transparent;
    border: none;
    outline: none;
}

/* Scrollbars */
QScrollBar:vertical {
	color: #000000;
	background: #ffffff;
	background-image: url(assets/scrollbars/bar-v.svg);
	background-repeat: repeat-y;
	background-position: center;
	background-attachment: fixed;
	width: 15px;
	padding: 15px 0px;
}

QScrollBar::handle:vertical {
	color: #000000;
	background: transparent;
	border: 1px solid transparent;
	border-image: url(assets/scrollbars/handle-v.svg);
	min-height: 24px;
	margin: 0px 1px;
}

QScrollBar::add-line:vertical {
	color: #000000;
	background: transparent;
	border: 0px solid transparent;
	border-image: url(assets/scrollbars/arrow-down.svg);
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:vertical:pressed {
	border-image: url(assets/scrollbars/handle-active-v.svg);
}

QScrollBar::sub-line:vertical {
	color: #000000;
	background: transparent;
	border: 0px solid transparent;
	border-image: url(assets/scrollbars/arrow-up.svg);
}

QScrollBar::add-line:vertical:hover {
	border-image: url(assets/scrollbars/arrow-down-hover.svg);
}

QScrollBar::add-line:vertical:pressed {
	border-image: url(assets/scrollbars/arrow-down-pressed.svg);
}

QScrollBar::sub-line:vertical:hover {
	border-image: url(assets/scrollbars/arrow-up-hover.svg);
}

QScrollBar::sub-line:vertical:pressed {
	border-image: url(assets/scrollbars/arrow-up-pressed.svg);
}

QScrollBar:horizontal {
	color: #000000;
	background: #ffffff;
	background-image: url(assets/scrollbars/bar-h.svg);
	background-repeat: repeat-x;
	background-position: center;
	background-attachment: fixed;
	height: 15px;
	padding: 0px 15px;
}

QScrollBar::handle:horizontal {
	color: #000000;
	background: transparent;
	border: 1px solid transparent;
	border-image: url(assets/scrollbars/handle-h.svg);
	min-width: 24px;
	margin: 1px 0px;
}

QScrollBar::add-line:horizontal {
	color: #000000;
	background: transparent;
	border: 0px solid transparent;
	border-image: url(assets/scrollbars/arrow-right.svg);
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:horizontal:pressed {
	border-image: url(assets/scrollbars/handle-active-h.svg);
}

QScrollBar::sub-line:horizontal {
	color: #000000;
	background: transparent;
	border: 0px solid transparent;
	border-image: url(assets/scrollbars/arrow-left.svg);
}

QScrollBar::add-line:horizontal:hover {
	border-image: url(assets/scrollbars/arrow-right-hover.svg);
}

QScrollBar::add-line:horizontal:pressed {
	border-image: url(assets/scrollbars/arrow-right-pressed.svg);
}

QScrollBar::sub-line:horizontal:hover {
	border-image: url(assets/scrollbars/arrow-left-hover.svg);
}

QScrollBar::sub-line:horizontal:pressed {
	border-image: url(assets/scrollbars/arrow-left-pressed.svg);
}

/* Backlight controls */
#Backlight {
	margin: 6px 0px;
}

#Backlight > SliderDialog {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/menus/frame.svg);
	min-width: 32px;
	min-height: 140px;
}

#Backlight QSlider {
	color: #000000;
	background: transparent;
	width: 6px;
	min-height: 120px;
	margin: 6px 0px;
}

#Backlight QSlider::handle {
	color: transparent;
	background: transparent;
	border: 0px solid transparent;
	border-image: url(assets/scrollbars/slider.svg);
	height: 30px;
	margin: 0px -1px;
}

#Backlight QSlider::handle:hover,
#Backlight QSlider::handle:pressed {
	border-image: url(assets/scrollbars/slider-active.svg);
}

#Backlight QSlider::groove {
	color: transparent;
	background: transparent;
	background-image: url(assets/scrollbars/sub-page.svg);
	background-repeat: repeat-y;
	background-position: top;
	background-attachment: fixed;
    border-top: 1px solid #a0b2c0;
    border-bottom: 1px solid #b0c2c8;
    border-left: 1px solid #a0b2c0;
    border-right: 1px solid #b0c2c8;
	border-radius: 2px;
    width: 4px;
}

#Backlight QSlider::sub-page {
	color: transparent;
	background: transparent;
	background-image: url(assets/scrollbars/groove.svg);
	background-repeat: repeat-y;
	background-position: top;
	background-attachment: fixed;
    border-top: 1px solid #a0b2c0;
    border-bottom: 1px solid #b0c2c8;
    border-left: 1px solid #a0b2c0;
    border-right: 1px solid #b0c2c8;
	border-radius: 2px;
    width: 4px;
}

#Backlight > SliderDialog > QToolButton {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/buttons/button.svg);
	margin: 2px;
	padding: 2px;
}

#Backlight > SliderDialog > QToolButton:hover {
	border-image: url(assets/buttons/button-hover.svg);
}

#Backlight > SliderDialog > QToolButton:pressed {
	border-image: url(assets/buttons/button-pressed.svg);
}

/* Volume controls - Multisink plugin for LXQt 2.4.x and up */
#Volume {
	margin: 6px 0px;
}

VolumePopup,
VolumePopup QScrollArea {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/menus/frame.svg);
}

VolumePopup QPushButton {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/buttons/button.svg);
	margin: 2px;
	padding: 2px;
}

VolumePopup QPushButton:hover {
	border-image: url(assets/buttons/button-hover.svg);
}

VolumePopup QPushButton:on,
VolumePopup QPushButton:pressed {
	border-image: url(assets/buttons/button-pressed.svg);
}

VolumePopup QSlider::handle:horizontal {
	width: 30px;
	margin: -1px 0px;
	border-image: url(assets/scrollbars/slider-h.svg);
}

VolumePopup QSlider::handle:horizontal:hover,
VolumePopup QSlider::handle:horizontal:pressed {
	border-image: url(assets/scrollbars/slider-active-h.svg);
}

VolumePopup QSlider::groove:horizontal {
	color: transparent;
	background: transparent;
	background-image: url(assets/scrollbars/groove-h.svg);
	background-repeat: repeat-x;
	background-position: left;
	background-attachment: fixed;
    border-top: 1px solid #a0b2c0;
    border-bottom: 1px solid #b0c2c8;
    border-left: 1px solid #a0b2c0;
    border-right: 1px solid #b0c2c8;
	border-radius: 2px;
    height: 4px;
}

VolumePopup QSlider::sub-page:horizontal {
	color: transparent;
	background: transparent;
	background-image: url(assets/scrollbars/sub-page-h.svg);
	background-repeat: repeat-x;
	background-position: left;
	background-attachment: fixed;
    border-top: 1px solid #a0b2c0;
    border-bottom: 1px solid #b0c2c8;
    border-left: 1px solid #a0b2c0;
    border-right: 1px solid #b0c2c8;
	border-radius: 2px;
    height: 4px;
}

/* Calendar */
QCalendarWidget QAbstractItemView {
	color: #000000;
	background: #ffffff;
	alternate-background-color: #eff3f7;
}

QCalendarWidget QAbstractItemView:enabled {
	selection-color: #ffffff;
	selection-background-color: #5d658e;
}

QCalendarWidget QAbstractItemView:disabled {
	color: #b6c3cf;
	background: #ffffff;
}

QCalendarWidget #qt_calendar_navigationbar {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/menus/frame.svg);
}

QCalendarWidget QToolButton {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: none;
	margin: 2px;
	padding: 1px 0px;
}

QCalendarWidget QToolButton:hover {
	border-image: url(assets/buttons/button-hover.svg);
}

QCalendarWidget QToolButton:pressed {
	border-image: url(assets/buttons/button-pressed.svg);
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

QCalendarWidget #qt_calendar_prevmonth {
    qproperty-icon: url(assets/arrows/arrow-left.svg);
    qproperty-iconSize: 16px;
	margin: 2px;
	padding: 2px;
}

QCalendarWidget #qt_calendar_nextmonth {
    qproperty-icon: url(assets/arrows/arrow-right.svg);
    qproperty-iconSize: 16px;
	margin: 2px;
	padding: 2px;
}

QCalendarWidget QSpinBox {
	color: #000000;
	background: transparent;
	border: 2px solid transparent;
	border-image: url(assets/boxes/spinbox.svg);
	selection-color: #ffffff;
	selection-background-color: #5d658e;
	margin: 1px 0px;
}

QCalendarWidget QSpinBox::up-button {
	border: 1px solid transparent;
	border-image: url(assets/buttons/spin-up.svg);
	subcontrol-origin: border;
	subcontrol-position: top right;
	width: 11px;
	margin-bottom: -1px;
}

QCalendarWidget QSpinBox::up-button:hover {
	border-image: url(assets/buttons/spin-up-hover.svg);
}

QCalendarWidget QSpinBox::up-button:pressed {
	border-image: url(assets/buttons/spin-up-pressed.svg);
}

QCalendarWidget QSpinBox::up-arrow {
	background-image: url(assets/arrows/spin-up.svg);
    background-repeat: no-repeat;
    background-position: center;
    background-attachment: fixed;
}

QCalendarWidget QSpinBox::down-button {
	border: 1px solid transparent;
	border-image: url(assets/buttons/spin-down.svg);
	subcontrol-origin: border;
	subcontrol-position: bottom right;
	width: 11px;
	margin-top: -1px;
}

QCalendarWidget QSpinBox::down-button:hover {
	border-image: url(assets/buttons/spin-down-hover.svg);
}

QCalendarWidget QSpinBox::down-button:pressed {
	border-image: url(assets/buttons/spin-down-pressed.svg);
}

QCalendarWidget QSpinBox::down-arrow {
	background-image: url(assets/arrows/spin-down.svg);
    background-repeat: no-repeat;
    background-position: center;
    background-attachment: fixed;
}

/* Clock and System Tray */
#WorldClock {
	margin: 0px;
	padding: 2px 4px;
}

#StatusNotifier QToolButton {
	color: #000000;
	background: transparent;
	padding: 6px 2px;
}

/* Keyboard state indicators */
#KbIndicator > QLabel, #KbIndicator > QToolButton {padding: 2px;}

#KbIndicator #LayoutLabel {background: transparent;}

#KbIndicator #CapsLockLabel {color: #b6c3cf; font: normal;}
#KbIndicator #CapsLockLabel:enabled {color: #000000; font: bold;}
#KbIndicator #CapsLockLabel:!enabled {color: #000000; font: normal;}
#KbIndicator #CapsLockLabel:disabled {color: #b6c3cf; font: normal;}

#KbIndicator #NumLockLabel {color: #b6c3cf; font: normal;}
#KbIndicator #NumLockLabel:enabled {color: #000000; font: bold;}
#KbIndicator #NumLockLabel:!enabled {color: #000000; font: normal;}
#KbIndicator #NumLockLabel:disabled {color: #b6c3cf; font: normal;}

#KbIndicator #ScrollLockLabel {color: #b6c3cf; font: normal;}
#KbIndicator #ScrollLockLabel:enabled {color: #000000; font: bold;}
#KbIndicator #ScrollLockLabel:!enabled {color: #000000; font: normal;}
#KbIndicator #ScrollLockLabel:disabled {color: #b6c3cf; font: normal;}

/* System Monitors and Graphs */
#LXQtCpuLoad {
    qproperty-fontColor: #000000;
}

#SysStat_Graph {
    /* CPU */
    qproperty-gridColor: #b6c3cf;
    qproperty-titleColor: #000000;
    qproperty-cpuSystemColor: #5d658e;
    qproperty-cpuUserColor: #808dc1;
    qproperty-cpuNiceColor: #3d4467;
    qproperty-cpuOtherColor: #272f4f;
    qproperty-frequencyColor: #5d658e;

    /* RAM */
    qproperty-memAppsColor: #5d658e;
    qproperty-memBuffersColor: #808dc1;
    qproperty-memCachedColor: #272f4f;

    /* Swap */
    qproperty-swapUsedColor: #272f4f;

    /* Networking */
    qproperty-netReceivedColor: #5d658e;
    qproperty-netTransmittedColor: #272f4f;
}
